{
  "manifest_version": 3,
  "name": "My Watch Later",
  "version": "0.1.0",
  "description": "Right-click any YouTube video to save it, then browse, filter and rewatch your list in a clean dialog.",
  "minimum_chrome_version": "105",
  "permissions": ["contextMenus", "storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/loader.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/*.js", "content/*.css", "lib/*.js"],
      "matches": ["https://www.youtube.com/*"]
    }
  ],
  "action": {
    "default_title": "My Watch Later",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
